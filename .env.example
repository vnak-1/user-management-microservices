# Copy this into each service folder as .env and adjust the values.
# The JWT_SECRET must be IDENTICAL in api-gateway and login-service.
# The INTERNAL_KEY must be IDENTICAL in all five services.

PORT=300X
SERVICE_NAME=SERVICE-NAME
MONGO_URI=mongodb://127.0.0.1:27017/userdb
JWT_SECRET=my_super_secret_jwt_key_change_me
JWT_EXPIRES_IN=1h
INTERNAL_KEY=gateway_internal_key_2026
